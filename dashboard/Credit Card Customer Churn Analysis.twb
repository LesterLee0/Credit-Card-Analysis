      <aliases enabled='yes' />
      <column caption='Usage Level' datatype='string' name='[Calculation_1900519092603265024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_trans_ct] &lt;= 60 THEN &quot;Low usage&quot; ELSE &quot;High usage&quot; END' />
      </column>
      <column caption='Product Level' datatype='string' name='[Calculation_1900519092603363329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_relationship_count] &lt;= 2 THEN &quot;1-2 products&quot; ELSE &quot;3+ products&quot; END' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_575264532755398656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([churn])' />
      </column>
      <column caption='Transaction Bucket' datatype='string' name='[Calculation_666955006440390657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_trans_ct] &lt;= 20 THEN &quot;1-20&quot;&#10;ELSEIF [total_trans_ct] &lt;= 40 THEN &quot;21-40&quot;&#10;ELSEIF [total_trans_ct] &lt;= 60 THEN &quot;41-60&quot;&#10;ELSEIF [total_trans_ct] &lt;= 80 THEN &quot;61-80&quot;&#10;ELSE &quot;80+&quot;&#10;END' />
      </column>
